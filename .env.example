# Copy this file to .env and replace the placeholders. URL-encode special
# characters in the PostgreSQL username and password.
DATABASE_URL=postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5433/ecommerce
DEFAULT_EXECUTION_MODE=pro

# At least one LLM provider key is required. Gemini is tried first.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=

# Optional fallback providers.
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
COHERE_API_KEY=

# Optional LangSmith tracing.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=enterprise-ai-text-to-sql
